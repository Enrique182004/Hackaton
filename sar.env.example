# Room settings for the SAR Whiteboard Assistant.
# Copy this file to `sar.env` (it is git-ignored) and adjust; `python -m biobench_sar` and
# `scripts/hardware_check.py` load it automatically. Real environment variables still win.

# --- Kit: Logitech C930e webcam -----------------------------------------------------------
# 1080p30, 90° diagonal (≈82° horizontal × 52° vertical). Full HD is what lets the high-res
# ink crop keep decimal points and minus signs readable.
SAR_CAMERA_WIDTH=1920
SAR_CAMERA_HEIGHT=1080
# Which camera: 0 is usually the laptop's built-in one. Run scripts/hardware_check.py to see
# the camera list and pick the C930e's index.
SAR_CAMERA_INDEX=1

# --- Kit: Epson WXGA 3LCD projector --------------------------------------------------------
# Native resolution 1280×800 (16:10). Set the projector as an extended (not mirrored) display
# at 1280×800 and open the projector page full screen on it.
SAR_PROJECTOR_WIDTH=1280
SAR_PROJECTOR_HEIGHT=800

# --- Tutor ----------------------------------------------------------------------------------
SAR_PROFILE=math
# auto = answer in the language the student speaks (English or Spanish)
SAR_LANGUAGE=auto

# --- Ink detection (math defaults from the small-symbol sweep) --------------------------
SAR_INK_MIN_AREA=150
SAR_INK_MAX_REGIONS=20

# --- Model ----------------------------------------------------------------------------------
SAR_VLM_BACKEND=ollama
SAR_VLM_MODEL=qwen2.5vl:3b
